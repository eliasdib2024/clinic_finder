# Copy this file to .env and fill in your own values. Never commit .env.
# App Environment (development | production | test)
NODE_ENV=development

# Server Port
PORT=3000

# Logging Level (error | warn | info | debug)
LOG_LEVEL=info

# Frontend address(es) allowed to call the API, comma-separated
CORS_ORIGIN=http://localhost:5173


# Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/clinicfinder?schema=public"

# Password hashing – the pepper is a secret mixed into every password before bcrypt.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Set it ONCE: changing it later makes every existing password invalid.
BCRYPT_ROUNDS=12
PASSWORD_PEPPER=replace-with-a-long-random-secret-at-least-32-chars

# Sign-in tokens (JWT) – generate the same way as the pepper, but use a DIFFERENT value
JWT_SECRET=replace-with-another-long-random-secret-32-chars
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d

# First administrator (created by: npm run db:seed)
ADMIN_NAME="ClinicFinder Admin"
ADMIN_EMAIL=admin@clinicfinder.lb
ADMIN_PASSWORD="Change-Me-Now#2026"   # quote values that contain #
ADMIN_PHONE=+9611000000



